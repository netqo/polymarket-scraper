# .env.example -- copy to .env (gitignored) and fill in real local values.
#
# This project is deliberately credential-free: it reads only public, read-only
# Polymarket market data and has no API keys, no wallet material, and no access
# to order endpoints (requirement A6). There is nothing secret to put here, and
# there never should be. Every variable below is a convenience override with a
# working default.
#
# | Variable               | Required | Description                                |
# |------------------------|----------|--------------------------------------------|
# | LOG_LEVEL              | no       | debug/info/warn/error (default info)       |
# | POLYMARKET_LIVE_TOKENS | no       | Token file path; enables `make test-live`  |

LOG_LEVEL=info
# POLYMARKET_LIVE_TOKENS=/tmp/tokens.txt
